# Portuguese (Brazil) translation for wingpanel-indicator-nowplaying.
msgid ""
msgstr ""
"Project-Id-Version: wingpanel-indicator-nowplaying\n"
"Language: pt_BR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "Shuffle"
msgstr "Aleatório"

msgid "Previous"
msgstr "Anterior"

msgid "Next"
msgstr "Próxima"

msgid "Pause"
msgstr "Pausar"

msgid "Play"
msgstr "Reproduzir"

msgid "Repeat: current track"
msgstr "Repetir: faixa atual"

msgid "Repeat: all"
msgstr "Repetir: tudo"

msgid "Repeat: off"
msgstr "Repetir: desligado"

msgid "Vinyl"
msgstr "Vinil"

msgid "Lyrics"
msgstr "Letra"

msgid "Nothing is playing"
msgstr "Nada tocando"

msgid "No lyrics found for this song"
msgstr "Nenhuma letra encontrada para esta música"

msgid "♪ Instrumental ♪"
msgstr "♪ Instrumental ♪"

msgid "Indicator Preferences…"
msgstr "Preferências do indicador…"

msgid "Preferences"
msgstr "Preferências"

msgid "Panel text width"
msgstr "Largura do texto no painel"

msgid "Show artist in the panel"
msgstr "Mostrar artista no painel"

msgid "Keep long titles scrolling"
msgstr "Manter títulos longos rolando"

msgid "Show when nothing is playing"
msgstr "Mostrar quando nada estiver tocando"

msgid "Tip: double-click the cover for the vinyl, triple-click for the lyrics."
msgstr "Dica: clique duas vezes na capa para o vinil, três vezes para a letra."

msgid "Show lyrics in the panel"
msgstr "Mostrar a letra no painel"

msgid "Shows the line being sung when synced lyrics are found; otherwise, the song name."
msgstr "Mostra o trecho que está sendo cantado quando houver letra sincronizada; senão, o nome da música."

msgid "Player"
msgstr "Player"

msgid "Local file"
msgstr "Arquivo local"

msgid "Lyrics sources"
msgstr "Fontes de letras"

msgid "Free and open lyrics database."
msgstr "Banco de letras aberto e gratuito."

msgid "Great for Asian music. Unofficial access: it may stop working at any time."
msgstr "Ótimo para músicas asiáticas. Acesso não oficial: pode parar de funcionar a qualquer momento."

msgid "Lyrics sent by the player and .lrc files (next to the song or in ~/.lyrics) are always used first."
msgstr "Letras enviadas pelo player e arquivos .lrc (ao lado da música ou em ~/.lyrics) sempre têm prioridade."
